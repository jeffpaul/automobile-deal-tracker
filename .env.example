# MarketCheck API key — https://www.marketcheck.com developer portal.
# The Free plan (500 calls/month) covers this tracker's ~300 calls/month;
# set MC_MAX_ROWS=500 to match its pagination cap.
MARKETCHECK_API_KEY=
MC_MAX_ROWS=1500
MC_MAX_MILES=60000

# Optional: CARFAX via Apify (parseforge/carfax-scraper). Off by default.
CARFAX_ENABLED=false
APIFY_API_TOKEN=

# Destination email address for deal alerts
ALERT_EMAIL_TO=

# Sending email address (Gmail recommended)
ALERT_EMAIL_FROM=

# SMTP server settings — defaults work for Gmail with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
