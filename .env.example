# MarketCheck API key — https://www.marketcheck.com developer portal (Basic plan or higher)
MARKETCHECK_API_KEY=

# Apify API token — https://apify.com — used to run the parseforge/carfax-scraper actor
APIFY_API_TOKEN=

# Destination email address for deal alerts
ALERT_EMAIL_TO=

# Sending email address (Gmail recommended)
ALERT_EMAIL_FROM=

# SMTP server settings — defaults work for Gmail with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
