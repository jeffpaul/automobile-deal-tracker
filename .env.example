# Copy to .env and fill in your values

# --- API Keys ---
MARKETCHECK_API_KEY=          # marketcheck.com developer portal
CARAPIS_API_KEY=               # my.carapis.com — enable all 6 parsers
APIFY_API_TOKEN=               # apify.com — for CARFAX scraper actor

# --- Email (Gmail App Password recommended) ---
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=alerts@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=                 # 16-char Gmail App Password (not your account password)
                               # Generate at: myaccount.google.com > Security > App passwords
